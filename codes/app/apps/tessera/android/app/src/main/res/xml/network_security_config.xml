<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (plain HTTP) is permitted ONLY for the on-device WebView prover's
  loopback server and the Android-emulator host alias. Every other destination
  must use TLS.

  Why this file exists: on targetSdk 28+ cleartext is blocked by default, so a
  RELEASE build hangs the prover the moment its headless WebView loads
  http://127.0.0.1:<port>/… (the bundled Groth16 proving page served over
  loopback by ProofWebViewHost). Scoping the exception to loopback keeps every
  real domain (relayer, RPC) TLS-only.

  Note: <base-config cleartextTrafficPermitted="false"> applies on API 24+.
  On API 21–23 this config is ignored by the platform and cleartext is allowed
  by default, which is harmless here (the only cleartext target is loopback;
  real endpoints are https regardless).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
