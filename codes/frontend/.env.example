# Network selection — picks the chain wagmi connects to and the chainId
# entry to read from src/deployed-addresses.json.
#   hardhat  → chainId 31337, default RPC http://127.0.0.1:8545
#   sepolia  → chainId 11155111, VITE_RPC_URL is REQUIRED
VITE_NETWORK=hardhat

# Override the RPC endpoint for the active network. Required when
# VITE_NETWORK=sepolia. Optional for hardhat (defaults to local node).
# VITE_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>

# Gasless relayer URL. Defaults to http://localhost:3001 if unset.
# VITE_RELAYER_URL=http://localhost:3001
