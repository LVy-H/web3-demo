{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:record": "playwright test --headed --reporter=html",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:metamask:cache": "PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers nix shell nixpkgs#chromium -c npx synpress e2e/wallet-setup",
    "test:e2e:metamask": "PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers nix shell nixpkgs#chromium -c npx playwright test --config=playwright-metamask.config.ts"
  },
  "dependencies": {
    "@noble/curves": "^1.2.0",
    "@noble/hashes": "^1.3.2",
    "@scure/base": "^1.2.6",
    "@semaphore-protocol/group": "^4.14.2",
    "@semaphore-protocol/identity": "^4.14.2",
    "@semaphore-protocol/proof": "^4.14.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.90.21",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-qr-code": "^2.0.21",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.3.0",
    "viem": "^2.46.3",
    "wagmi": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@synthetixio/synpress": "^4.1.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.7"
  }
}
