<?xml version="1.0" encoding="utf-8"?>
<!--
  Permit cleartext HTTP ONLY for loopback and the emulator's host alias — every
  real domain stays cleartext-blocked (the modern-targetSdk default).

  Why this exists: the on-device Semaphore prover (ProofServiceMobile) runs
  web/zkprover.js in a headless WebView and serves the bundled Groth16 artifacts
  from an in-app loopback HttpServer at http://127.0.0.1:<port>. That URL is
  cleartext, so without this allow-list a RELEASE build blocked the page load,
  zkprover.js never ran, window.zkGenerateVoteProof never appeared, and the host
  timed out: "WebView prover host never reached readiness". (The prover only ever
  worked in debug, which set usesCleartextTraffic=true.) This scopes the
  exception to loopback so release builds can prove on-device while staying
  locked down for everything else.

  127.0.0.1 / localhost — the in-app loopback prover server.
  10.0.2.2              — the Android emulator's alias to the dev host (Hardhat
                          :8545 + relayer :3001) used by the e2e harness.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
