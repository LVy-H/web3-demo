<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Cleartext to the emulator host (10.0.2.2:8545 Hardhat / :3001 relayer)
         and loopback is now permitted for ALL build types by the scoped
         res/xml/network_security_config.xml (real domains stay blocked). That
         config also unblocks the on-device prover's loopback server in RELEASE,
         so the previous debug-only usesCleartextTraffic="true" is redundant. -->
    <application>
        <!-- Debug-only: render with Skia instead of Impeller. The dev/CI
             emulator recipe for this host (API-31 x86_64, swiftshader GL) hits
             Impeller GL aborts / 0-width surfaces; Skia is the known-good path
             for the on-device WebView proving spike. Release/profile keep the
             Flutter default (Impeller); web/desktop are unaffected. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>
</manifest>
