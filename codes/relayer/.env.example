RPC_URL=http://127.0.0.1:8545
# Local dev: paste the Hardhat account #0 private key here (printed by `npm run node`)
# Production: NEVER commit this value. Use a secrets manager (Vault, AWS KMS, etc.)
RELAYER_PRIVATE_KEY=0x<paste-your-key-here>
PORT=3001

# ── Sponsored poll lifecycle (wallet-free create / register / start) ─────────
# Address of the deployed PollRegistry the relayer creates polls through. The
# relayer must be a registered module owner of THIS registry (it pays gas and
# owns every sponsored poll). REQUIRED for POST /api/relay/create-poll — without
# it the relayer still boots and serves all other routes, but create-poll
# returns 503 "isn't configured". GET /api/relay/info reports it (or null).
REGISTRY_ADDRESS=0x<deployed-PollRegistry-address>

# Optional operator gate on WHO can mint sponsored polls. When set, every
# create-poll request must send a matching `X-Create-Secret` header; when unset
# (local/dev) create is OPEN. NOTE: this is a light gate, NOT Sybil-resistant —
# it does not gate voting or registration. Production needs more (captcha,
# proof-of-humanity, etc.).
# CREATE_SECRET=

# Abuse caps (in-memory; reset on restart, per process — not shared across
# replicas). Defaults shown. The relayer pays gas per create/register, so these
# keep a casual abuser from draining its balance.
# CREATE_DAILY_MAX=5          # per-IP sponsored polls per day
# REGISTER_PER_POLL_MAX=50    # per-(IP, pollAddress) join attempts per day
