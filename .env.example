# Root .env.example — values consumed by docker-compose.yml.
# Copy to `.env` (which is gitignored) and override per environment.
#
# IMPORTANT: this file documents *which* knobs the compose stack reads, NOT a
# safe set of production credentials. Anything not overridden falls back to a
# hardcoded dev default that is fine for local-only Hardhat work but unsafe
# anywhere a real chain is involved.

# ───────────────────────────────────────────────────────────────────────────
# Relayer signing key
# ───────────────────────────────────────────────────────────────────────────
# Private key used by the relayer service to pay gas on behalf of users.
# Default (when unset): Hardhat account #0 — well-known dev key, never funded
# on any real network. Override for ANY non-dev deploy (devnet, testnet, prod).
#
# Generate a fresh key for non-dev use, e.g.:
#   node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
# or use a secrets manager (Vault, AWS KMS, GCP Secret Manager, etc.) and
# inject at process start rather than committing the value here.
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
